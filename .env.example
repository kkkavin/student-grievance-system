# PORT: Local server port (defaults to 3000)
PORT=3000

# -------------------------------------------------------------
# OPTIONAL CONFIGURATION (NO API KEY REQUIRED TO RUN LOCALLY)
# The application runs 100% locally with SQLite3 and local heuristic AI.
# -------------------------------------------------------------

# GEMINI_API_KEY: Optional. If omitted, smart local heuristic AI classification is used.
GEMINI_API_KEY=

# Gmail / SMTP Configuration (Optional):
# If omitted, OTPs and notifications are logged locally in the terminal and stored in the SQLite outbox.
GMAIL_USER=
GMAIL_APP_PASSWORD=
