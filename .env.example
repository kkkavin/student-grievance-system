# ==============================================================================
# Campus Grievance Management System - Environment Configuration Template
# ==============================================================================

# Server Ports & URLs
PORT=3000
FASTAPI_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
ENVIRONMENT=development

# Database Persistence (PostgreSQL 16 + pgvector)
# For local Docker / production:
DATABASE_URL=postgresql+asyncpg://<username>:<password>@localhost:5432/campus_grievance_db
# In-memory / SQLite async fallback (used automatically when PostgreSQL is offline):
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./backend.sqlite

# Authentication & JWT Security (RFC 7519 HS256)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=86400

# Groq LLM Triage Agent (Optional: falls back to deterministic local heuristic if unset)
GROQ_API_KEY=your_groq_api_key_here

# SMTP / Email Configuration (Optional: falls back to console logger if unset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
GMAIL_USER=
GMAIL_APP_PASSWORD=
