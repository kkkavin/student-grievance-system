# ==============================================================================
# Campus Grievance Management System - Environment Configuration
# ==============================================================================

# Server Ports & URLs
PORT=3000
FASTAPI_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:3000/api
ENVIRONMENT=development

# Database Persistence (PostgreSQL 16 + pgvector)
# For local Docker / production:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/grievance_db
# In-memory / SQLite async fallback (used automatically when PostgreSQL is offline):
SQLITE_FALLBACK_URL=sqlite+aiosqlite:///./database.sqlite

# Authentication & JWT Security (RFC 7519 HS256)
JWT_SECRET=grievance-system-jwt-secret-key-prod-2026
JWT_ALGORITHM=HS256
JWT_EXPIRATION_SECONDS=86400

# Optional External Integrations (100% locally simulated when omitted)
# GEMINI_API_KEY: Optional LLM classifier. If omitted, smart local heuristic AI is used.
GEMINI_API_KEY=

# Gmail / SMTP Configuration (Optional):
# If omitted, OTPs and notifications are logged to terminal and stored in the database outbox.
GMAIL_USER=
GMAIL_APP_PASSWORD=
