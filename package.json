{
  "name": "campus-grievance-monorepo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Production Full-Stack AI Campus Grievance Redressal System Monorepo",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "concurrently -k -p \"[{name}]\" -n \"FASTAPI,NEXTJS\" -c \"cyan.bold,magenta.bold\" \"npm run backend\" \"npm run frontend\"",
    "backend": "node scripts/run.mjs backend",
    "frontend": "npm --prefix frontend run dev",
    "db:seed": "node scripts/run.mjs db:seed",
    "db:reset": "node scripts/run.mjs db:reset",
    "test": "node scripts/run.mjs test",
    "test:backend": "node scripts/run.mjs test:backend",
    "test:frontend": "npm --prefix frontend test",
    "build": "npm --prefix frontend run build",
    "lint": "node scripts/run.mjs lint",
    "graphify:update": "graphify update . --force"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
